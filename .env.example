# ==============================================================================
# 01Blog - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to '.env' to customize your credentials.
# Note: In Zone01 Linux developer environments, standard defaults are configured
# in 'application.properties' so the project also boots out-of-the-box.
# ==============================================================================

# Database Connection (PostgreSQL 16)
DB_URL=jdbc:postgresql://localhost:5432/blog_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT Authentication Secret (Must be at least 256 bits / 32 characters)
JWT_SECRET=supersecretkey01blogmustbeatleast256bitslongforsecurity
JWT_EXPIRATION_MS=86400000

# Server Port
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# Platform Roles:
# The very first user who registers on the website automatically receives
# ROLE_ADMIN (Platform Administrator). All subsequent users receive ROLE_USER.
# ------------------------------------------------------------------------------

